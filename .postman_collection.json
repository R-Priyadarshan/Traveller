    {
      "name": "Trip Planning",
      "item": [
        {
          "name": "Generate Itinerary - India",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"india for 5 people adventure trip\",\n  \"preferences\": [\"hiking\", \"temples\", \"cultural\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/plan?language=en&save=true",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "plan"],
              "query": [
                {
                  "key": "language",
                  "value": "en"
                },
                {
                  "key": "save",
                  "value": "true"
                }
              ]
            }
          }
        },
